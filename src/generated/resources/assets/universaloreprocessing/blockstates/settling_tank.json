{
  "multipart": [
    {
      "apply": {
        "model": "universaloreprocessing:block/settling_tank"
      }
    },
    {
      "apply": {
        "model": "universaloreprocessing:block/settling_tank_water"
      },
      "when": {
        "stage": "1"
      }
    },
    {
      "apply": {
        "model": "universaloreprocessing:block/settling_tank_murky"
      },
      "when": {
        "stage": "2"
      }
    },
    {
      "apply": {
        "model": "universaloreprocessing:block/settling_tank_still"
      },
      "when": {
        "stage": "3|4|5|6"
      }
    },
    {
      "apply": {
        "model": "universaloreprocessing:block/settling_tank_crystals_1"
      },
      "when": {
        "stage": "4"
      }
    },
    {
      "apply": {
        "model": "universaloreprocessing:block/settling_tank_crystals_2"
      },
      "when": {
        "stage": "5"
      }
    },
    {
      "apply": {
        "model": "universaloreprocessing:block/settling_tank_crystals_3"
      },
      "when": {
        "stage": "6"
      }
    }
  ]
}